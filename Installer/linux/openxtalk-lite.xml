<?xml version="1.0" encoding="UTF-8"?>
<!--
  The file types OpenXTalk-Lite opens, for shared-mime-info: install.sh copies
  this file to ~/.local/share/mime/packages/openxtalk-lite.xml and runs
  update-mime-database. The same two types as the Windows installer
  registers (Installer/openxtalk-lite/openxtalk-lite.iss); LiveCode's .livecode,
  .livecodescript and .rev are left to LiveCode. Types are matched by
  their extension only: a magic rule for binary stacks ("REVO" at the
  start) would also claim .livecode and .rev files.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-oxtstack">
    <comment>OpenXTalk-Lite stack</comment>
    <icon name="openxtalk-lite"/>
    <glob pattern="*.oxtstack"/>
  </mime-type>
  <mime-type type="text/x-oxtscript">
    <comment>OpenXTalk-Lite script-only stack</comment>
    <sub-class-of type="text/plain"/>
    <icon name="openxtalk-lite"/>
    <glob pattern="*.oxtscript"/>
  </mime-type>
</mime-info>
